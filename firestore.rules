rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null &&
        exists(/databases/$(database)/documents/roles/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/roles/$(request.auth.uid)).data.role == 'admin';
    }

    // 🔹 Prebuilt products (public read, admin write)
    match /prebuilts/{productId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // 🔹 Addons (from your first rules)
    match /addons/{addonId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // 🔹 Homepage / app settings
    match /settings/{settingId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // 🔹 Roles collection
    match /roles/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow create, update, delete: if isAdmin();
    }

    // 🔹 EVENTS (your original logic preserved EXACTLY)
    match /events/{eventId} {
      allow read: if true;

      // ❗ Kept exactly as you wrote (no exists() added intentionally)
      allow write: if request.auth != null && 
        get(/databases/$(database)/documents/roles/$(request.auth.uid)).data.role == 'admin';
    }
  }
}